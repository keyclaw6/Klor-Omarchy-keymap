[Unit]
Description=OpenWhispr ElevenLabs Scribe adapter
Documentation=https://github.com/OpenWhispr/openwhispr
After=graphical-session.target network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.config/klor-bridge/openwhispr_elevenlabs_shim.py
Restart=on-failure
RestartSec=2
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
