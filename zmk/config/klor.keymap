#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>
#include <dt-bindings/klor/control.h>

#define BASE     0
#define LOWER    1
#define RAISE    2
#define ADJUST   3
#define NAV      4
#define TRAINING 5
#define COMMAND  6

/ {
    behaviors {
        klor_ctrl: klor_ctrl {
            compatible = "klor,behavior-control";
            #binding-cells = <2>;
            command-layer = <COMMAND>;
            training-layer = <TRAINING>;
            lower-layer = <LOWER>;
            raise-layer = <RAISE>;
            adjust-layer = <ADJUST>;
            nav-layer = <NAV>;
            command-timeout-ms = <3000>;
            ralt-tap-window-ms = <350>;
            stt-tap-window-ms = <300>;
        };

        hml: homerow_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <180>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <120>;
            bindings = <&kp>, <&kp>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <
                5 6 7 8 9
                16 17 18 19 20 21
                29 30 31 32 33 34 35
                40 41 42 43
            >;
        };

        hmr: homerow_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <180>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <120>;
            bindings = <&kp>, <&kp>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <
                0 1 2 3 4
                10 11 12 13 14 15
                22 23 24 25 26 27 28
                36 37 38 39
            >;
        };

        nav_l: nav_left_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <180>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <120>;
            bindings = <&mo>, <&kp>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <
                5 6 7 8 9
                16 17 18 19 20 21
                29 30 31 32 33 34 35
                40 41 42 43
            >;
        };

        nav_r: nav_right_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <180>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <120>;
            bindings = <&mo>, <&kp>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <
                0 1 2 3 4
                10 11 12 13 14 15
                22 23 24 25 26 27 28
                36 37 38 39
            >;
        };

        bspc_del: backspace_delete {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BSPC>, <&kp DEL>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        aa: danish_aa {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&unicode_aa_lower>, <&unicode_aa_upper>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        ae: danish_ae {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&unicode_ae_lower>, <&unicode_ae_upper>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        oe: danish_oe {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&unicode_oe_lower>, <&unicode_oe_upper>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
    };

    macros {
        unicode_aa_lower: unicode_aa_lower {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings
                = <&macro_press &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp U &kp N0 &kp N0 &kp E &kp N5 &kp ENTER>
                , <&macro_release &kp LSHFT &kp LCTRL>
                ;
        };

        unicode_aa_upper: unicode_aa_upper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings
                = <&macro_press &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp U &kp N0 &kp N0 &kp C &kp N5 &kp ENTER>
                , <&macro_release &kp LSHFT &kp LCTRL>
                ;
        };

        unicode_ae_lower: unicode_ae_lower {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings
                = <&macro_press &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp U &kp N0 &kp N0 &kp E &kp N6 &kp ENTER>
                , <&macro_release &kp LSHFT &kp LCTRL>
                ;
        };

        unicode_ae_upper: unicode_ae_upper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings
                = <&macro_press &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp U &kp N0 &kp N0 &kp C &kp N6 &kp ENTER>
                , <&macro_release &kp LSHFT &kp LCTRL>
                ;
        };

        unicode_oe_lower: unicode_oe_lower {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings
                = <&macro_press &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp U &kp N0 &kp N0 &kp F &kp N8 &kp ENTER>
                , <&macro_release &kp LSHFT &kp LCTRL>
                ;
        };

        unicode_oe_upper: unicode_oe_upper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings
                = <&macro_press &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp U &kp N0 &kp N0 &kp D &kp N8 &kp ENTER>
                , <&macro_release &kp LSHFT &kp LCTRL>
                ;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
                &kp Q             &kp W             &kp E             &kp R             &kp T
                &kp Y             &kp U             &kp I             &kp O             &kp P

                &kp TAB           &hml LGUI A        &hml LALT S        &hml LCTRL D       &hml LSHFT F       &nav_l NAV G
                &nav_r NAV H      &hmr RSHFT J       &hmr RCTRL K       &hmr LALT L        &hmr RGUI SEMI     &kp SQT

                &kp LGUI          &kp Z             &kp X             &kp C             &kp V             &kp B
                &kp C_MUTE        &kp C_PP
                &kp N             &kp M             &kp COMMA         &kp DOT           &kp FSLH          &mo NAV

                &kp LCTRL         &mo LOWER         &kp SPACE         &kp LSHFT
                &klor_ctrl KLOR_CTRL_RALT 0         &kp ENTER         &mo RAISE         &bspc_del
            >;
            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN
                &inc_dec_kp C_BRI_UP C_BRI_DN
            >;
        };

        lower_layer {
            bindings = <
                &kp CAPS          &kp HOME          &kp UP            &kp EQUAL         &kp LBRC
                &kp RBRC          &kp N7            &kp N8            &kp N9            &kp KP_PLUS

                &kp ESC           &kp DEL           &kp LEFT          &kp DOWN          &kp RIGHT         &kp LBKT
                &kp RBKT          &kp N4            &kp N5            &kp N6            &kp MINUS         &kp UNDER

                &kp PSCRN         &kp END           &kp PG_UP         &kp LC(S)         &kp PG_DN         &kp LPAR
                &kp C_MUTE        &kp C_PP
                &kp RPAR          &kp N1            &kp N2            &kp N3            &kp KP_MULTIPLY   &trans

                &trans            &trans            &trans            &trans
                &trans            &trans            &trans            &kp N0
            >;
            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN
                &inc_dec_kp C_BRI_UP C_BRI_DN
            >;
        };

        raise_layer {
            bindings = <
                &kp EXCL          &kp AT            &kp HASH          &kp DLLR          &kp PRCNT
                &kp CARET         &kp AMPS          &kp BSLH          &kp RA(N3)        &aa

                &kp LA(F13)       &kp F14           &kp F15           &kp F16           &kp F17           &kp RA(S)
                &kp RA(Y)         &kp RA(N5)        &kp RA(N4)        &kp RA(EQUAL)     &ae               &oe

                &kp LA(F18)       &kp F19           &kp F20           &kp F21           &kp F22           &kp F23
                &kp C_MUTE        &kp C_PP
                &kp RA(COMMA)     &kp RA(DOT)       &kp RA(C)         &kp LS(GRAVE)     &kp GRAVE         &trans

                &trans            &trans            &trans            &trans
                &trans            &trans            &trans            &trans
            >;
            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN
                &inc_dec_kp C_BRI_UP C_BRI_DN
            >;
        };

        adjust_layer {
            bindings = <
                &kp F15           &kp F16           &kp F17           &kp F18           &klor_ctrl KLOR_CTRL_TRAIN_TOGGLE 0
                &none             &kp F7            &kp F8            &kp F9            &kp F14

                &kp F20           &kp F21           &kp F22           &kp F23           &kp F24           &kp K_APP
                &none             &kp F4            &kp F5            &kp F6            &kp F12           &kp F13

                &bootloader       &none             &none             &none             &none             &none
                &kp C_MUTE        &kp C_PP
                &none             &kp F1            &kp F2            &kp F3            &kp F10           &kp F11

                &trans            &trans            &trans            &trans
                &trans            &trans            &trans            &bspc_del
            >;
            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN
                &inc_dec_kp C_BRI_UP C_BRI_DN
            >;
        };

        nav_layer {
            bindings = <
                &none             &kp LC(LG(LEFT))  &klor_ctrl KLOR_CTRL_NAV KLOR_NAV_UP   &kp LC(LG(RIGHT)) &none
                &none             &kp LG(N7)        &kp LG(N8)        &kp LG(N9)        &none

                &kp LG(TAB)       &none             &klor_ctrl KLOR_CTRL_NAV KLOR_NAV_LEFT &klor_ctrl KLOR_CTRL_NAV KLOR_NAV_DOWN &klor_ctrl KLOR_CTRL_NAV KLOR_NAV_RIGHT &kp LG(G)
                &none             &kp LG(N4)        &kp LG(N5)        &kp LG(N6)        &none             &none

                &none             &none             &none             &none             &none             &none
                &kp C_MUTE        &kp C_PP
                &none             &kp LG(N1)        &kp LG(N2)        &kp LG(N3)        &none             &trans

                &kp LCTRL         &none             &none             &kp LSHFT
                &kp LALT          &none             &none             &kp LG(N0)
            >;
            sensor-bindings = <
                &inc_dec_kp LG(TAB) LS(LG(TAB))
                &inc_dec_kp LG(TAB) LS(LG(TAB))
            >;
        };

        training_layer {
            bindings = <
                &trans            &trans            &trans            &trans            &trans
                &trans            &trans            &trans            &trans            &trans

                &trans            &trans            &trans            &trans            &trans            &trans
                &trans            &trans            &trans            &trans            &trans            &trans

                &klor_ctrl KLOR_CTRL_TRAIN_MOD LGUI &trans &trans &trans &trans &trans
                &trans            &trans
                &trans            &trans            &trans            &trans            &trans            &none

                &klor_ctrl KLOR_CTRL_TRAIN_MOD LCTRL &trans &trans &klor_ctrl KLOR_CTRL_TRAIN_MOD LSHFT
                &klor_ctrl KLOR_CTRL_RALT 0         &trans            &trans            &trans
            >;
            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN
                &inc_dec_kp C_BRI_UP C_BRI_DN
            >;
        };

        command_layer {
            bindings = <
                &klor_ctrl KLOR_CTRL_ACTION 0x51  &klor_ctrl KLOR_CTRL_ACTION 0x57  &klor_ctrl KLOR_CTRL_ACTION 0x45  &klor_ctrl KLOR_CTRL_ACTION 0x52  &klor_ctrl KLOR_CTRL_STT 0
                &klor_ctrl KLOR_CTRL_ACTION 0x59  &klor_ctrl KLOR_CTRL_ACTION 0x55  &klor_ctrl KLOR_CTRL_ACTION 0x49  &klor_ctrl KLOR_CTRL_ACTION 0x4F  &klor_ctrl KLOR_CTRL_ACTION 0x50

                &trans                            &klor_ctrl KLOR_CTRL_ACTION 0x41  &klor_ctrl KLOR_CTRL_ACTION 0x53  &klor_ctrl KLOR_CTRL_ACTION 0x44  &klor_ctrl KLOR_CTRL_ACTION 0x46  &klor_ctrl KLOR_CTRL_ACTION 0x47
                &klor_ctrl KLOR_CTRL_ACTION 0x48  &klor_ctrl KLOR_CTRL_ACTION 0x4A  &klor_ctrl KLOR_CTRL_ACTION 0x4B  &klor_ctrl KLOR_CTRL_ACTION 0x4C  &trans                            &trans

                &trans                            &klor_ctrl KLOR_CTRL_ACTION 0x5A  &klor_ctrl KLOR_CTRL_ACTION 0x58  &klor_ctrl KLOR_CTRL_ACTION 0x43  &klor_ctrl KLOR_CTRL_ACTION 0x56  &klor_ctrl KLOR_CTRL_ACTION 0x42
                &trans                            &trans
                &klor_ctrl KLOR_CTRL_ACTION 0x4E  &klor_ctrl KLOR_CTRL_ACTION 0x4D  &trans                            &trans                            &trans                            &trans

                &trans                            &trans                            &trans                            &trans
                &klor_ctrl KLOR_CTRL_RALT 0       &trans                            &trans                            &trans
            >;
            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN
                &inc_dec_kp C_BRI_UP C_BRI_DN
            >;
        };
    };
};
