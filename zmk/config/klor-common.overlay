/*
 * BeeKeeb KLOR rev1.3 + Sea-Picro RP2040.
 * Sea-Picro's legacy Pro Micro I/O pinout matches SparkFun Pro Micro RP2040.
 */
#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/rpi-pico-rp2040-pinctrl.h>

&uart0 { status = "disabled"; };
&i2c1 { status = "disabled"; };
&spi0 { status = "disabled"; };
&adc { status = "disabled"; };

&pinctrl {
    klor_split_uart_default: klor_split_uart_default {
        data_pins {
            /* KLOR D2 -> Sea-Picro RP2040 GP1. */
            pinmux = <PIO1_P1>;
            input-enable;
            bias-pull-up;
        };
    };
};

&pio1 {
    status = "okay";

    klor_split_uart: uart {
        compatible = "zmk,uart-rp2040-pio-half-duplex";
        status = "okay";
        current-speed = <19200>;
        pinctrl-0 = <&klor_split_uart_default>;
        pinctrl-names = "default";
    };
};

&gpio0 {
    klor_trrs_rx_guard {
        gpio-hog;
        /* KLOR D4/RX -> GP4. TRS bridges RX+TX; never drive this pad. */
        gpios = <4 GPIO_ACTIVE_HIGH>;
        input;
        line-name = "KLOR TRRS RX guard";
    };
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &klor_transform;
    };

    klor_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        rows = <8>;
        columns = <6>;
        map = <
            RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)
            RC(4,5) RC(4,4) RC(4,3) RC(4,2) RC(4,1)

            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)
            RC(5,5) RC(5,4) RC(5,3) RC(5,2) RC(5,1) RC(5,0)

            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)
            RC(3,5) RC(7,5)
            RC(6,5) RC(6,4) RC(6,3) RC(6,2) RC(6,1) RC(6,0)

            RC(3,1) RC(3,2) RC(3,3) RC(3,4)
            RC(7,4) RC(7,3) RC(7,2) RC(7,1)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        row-gpios
            = <&gpio0 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;

        col-gpios
            = <&gpio0 27 GPIO_ACTIVE_HIGH>
            , <&gpio0 26 GPIO_ACTIVE_HIGH>
            , <&gpio0 22 GPIO_ACTIVE_HIGH>
            , <&gpio0 20 GPIO_ACTIVE_HIGH>
            , <&gpio0 23 GPIO_ACTIVE_HIGH>
            , <&gpio0 21 GPIO_ACTIVE_HIGH>
            ;
    };

    left_encoder: encoder_left {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 28 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <40>;
        status = "disabled";
    };

    right_encoder: encoder_right {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio0 28 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <40>;
        status = "disabled";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder &right_encoder>;
        triggers-per-rotation = <20>;
    };

    wired_split {
        compatible = "zmk,wired-split";
        device = <&klor_split_uart>;
        half-duplex;
    };
};
