menuconfig KLOR_OMARCHY
    bool "KLOR Omarchy custom firmware support"
    default y

if KLOR_OMARCHY

config KLOR_OMARCHY_RAW_HID
    bool "QMK-compatible KLOR bridge Raw HID interface"
    default y if ZMK_USB
    depends on ZMK_USB && (!ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL)
    select USB_DEVICE_HID

endif
