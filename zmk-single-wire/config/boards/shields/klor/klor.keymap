#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp Q      &kp W      &kp E      &kp R      &kp T                                  &kp Y      &kp U      &kp I      &kp O      &kp P
                &kp TAB    &kp A      &kp S      &kp D      &kp F      &kp G                        &kp H      &kp J      &kp K      &kp L      &kp SEMI   &kp SQT
                &kp LCTRL  &kp Z      &kp X      &kp C      &kp V      &kp B      &trans  &trans    &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH   &kp BSLH
                                      &kp ESC    &kp LSHFT  &kp SPACE  &kp LALT   &kp LGUI  &kp ENTER  &kp BSPC  &kp RALT
            >;

            sensor-bindings = <&inc_dec_kp RIGHT LEFT &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
